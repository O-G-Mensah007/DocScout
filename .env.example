# ---------------------------------------------------------------------------
# Copy to .env.local for local dev. In production these are set in the Vercel
# dashboard (Project -> Settings -> Environment Variables). Never commit .env.
# ---------------------------------------------------------------------------

# Neon Postgres. Create a project at neon.tech, copy the pooled connection
# string. Use a Neon *branch* for local dev so you never touch prod data.
DATABASE_URL="postgresql://user:pass@host.neon.tech/docscout?sslmode=require"

# Anthropic API key for the extraction step. console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
EXTRACTION_MODEL="claude-sonnet-4-6"

# Shared secret guarding the /api/cron/* routes. Vercel Cron sends this as
# `Authorization: Bearer $CRON_SECRET`. Generate with: openssl rand -hex 32
CRON_SECRET="change-me"

# Contact address published in the crawler User-Agent, so a clinic
# administrator who wants to be delisted can reach a human. Required.
CRAWLER_CONTACT_EMAIL="hello@example.com"
CRAWLER_USER_AGENT="DocScoutBot/0.1 (+https://docscout.ca/bot; hello@example.com)"

# Layer 1 (roster) — optional, and unset by design.
#
# The CPSO Physician Register is NOT crawled. CPSO releases a standardised
# dataset of registered physicians (practice address, municipality, postal code,
# telephone) through a written request, restricted to continuity-of-care and
# health-resource-planning uses:
#   https://www.cpso.on.ca/public/services/need-college-data
#
# When a human has obtained that extract, point this at the CSV and
# `pnpm roster:load` will include it. Left unset, the loader prints why it is
# skipping the source and carries on. See docs/adr/0003-*.md before changing
# this — the reasoning is not about robots.txt.
CPSO_REGISTER_EXTRACT_PATH=""

# Optional at v1. Alerts no-op cleanly when unset.
RESEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@docscout.ca"

# Public base URL, used in alert emails and the bot info page.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
